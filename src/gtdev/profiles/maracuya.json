  "name": "maracuya",
  "description": "Standard exotic environment with DNF package management.",
  "guidance": [
    {
      "step": "Install GitHub CLI",
      "command": "sudo dnf install -y gh",
      "check": "command -v gh",
      "notes": "Required for repository discovery and build tracking."
    },
    {
      "step": "Configure Shell Path",
      "command": "echo \"export PATH=\\$PATH:~/.local/bin\" >> ~/.bashrc",
      "check": "grep -q \".local/bin\" ~/.bashrc",
      "notes": "Ensures gtdev and other local tools are in your PATH."
    }
  ],
  "package_manager": "dnf",
  "shell_profile": "~/.bashrc"
}
